--- 533,569 -----
+ 		let uploadCallCount = 0;
+ 
+ 		// Mock storage service to fail twice, then succeed
+ 		mockStorageService.upload.mockImplementation( async () => {
+ 			uploadCallCount++;
+ 
+ 			if ( uploadCallCount < 3 ) {
+ 				throw new Error( 'Network error' );
+ 			}
+ 
+ 			return {
+ 				success: true,
+ 				url: 'https://example.com/file.jpg',
+ 			};
+ 		} );
+ 
+ 		// Mock executeWithRetry to actually retry
+ 		errorHandler.executeWithRetry.mockReset();
+ 		errorHandler.executeWithRetry.mockImplementation(
+ 			async ( fn, options ) => {
+ 				const maxRetries = 3;
+ 				let lastError;
+ 
+ 				for ( let attempt = 1; attempt <= maxRetries; attempt++ ) {
+ 					try {
+ 						return await fn();
+ 					} catch ( error ) {
+ 						lastError = error;
+ 						if ( attempt < maxRetries && options?.onRetry ) {
+ 							options.onRetry( error, attempt );
+ 						}
+ 					}
+ 				}
+ 
+ 				throw lastError;
+ 			}
+ 		);
