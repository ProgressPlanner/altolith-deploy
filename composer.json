{
    "name": "aristath/aether-site-exporter",
    "description": "Export WordPress sites as static HTML or WordPress Playground blueprint bundles",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "*",
        "wp-coding-standards/wpcs": "*",
        "phpstan/phpstan": "*",
        "phpstan/extension-installer": "*",
        "szepeviktor/phpstan-wordpress": "*",
        "friendsofphp/php-cs-fixer": "^3.89",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-phpunit/wp-phpunit": "^6.6",
        "phpunit/phpunit": "^9.6",
        "mockery/mockery": "^1.6",
        "brain/monkey": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Aether\\SiteExporter\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aether\\SiteExporter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check-cs": "phpcs --standard=phpcs.xml",
        "fix-cs": [
            "phpcbf --standard=phpcs.xml",
            "php-cs-fixer fix --allow-risky=yes"
        ],
        "fix-cs-fixer": "php-cs-fixer fix --allow-risky=yes",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check-stan": "@phpstan",
        "check": [
            "@check-cs",
            "@phpstan"
        ],
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "process-timeout": 600
    }
}
