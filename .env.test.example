# E2E Test Configuration
# Copy this file to .env.test and update with your local values
# NEVER commit .env.test with real credentials!

# WordPress site URL (your Local by Flywheel site)
WP_BASE_URL=https://local.local

# WordPress admin credentials
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=password

# Aether configuration (for verification)
# These should match your plugin settings
R2_WORKER_ENDPOINT=https://aether-worker.your-account.workers.dev
R2_SITE_KEY=your-site-key

# Test options
# Run tests in headed mode (see browser) - useful for debugging
HEADED=false

# Slow down test execution (milliseconds) - useful for watching
SLOW_MO=0

# Enable debug logging
DEBUG=false

# ==============================================================================
# REAL CREDENTIALS FOR TESTING (Optional - only for integration tests)
# ==============================================================================
# Leave these blank to use mock values. Fill them in if you want to test
# against real APIs. These values are NEVER committed to git.

# Cloudflare Credentials
TEST_CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
TEST_CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# R2 Storage Credentials
TEST_R2_BUCKET_NAME=your-test-bucket-name
TEST_R2_ACCESS_KEY_ID=your-r2-access-key-id
TEST_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# GitHub Pages Credentials
TEST_GITHUB_USERNAME=your-github-username
TEST_GITHUB_REPOSITORY=your-test-repo
TEST_GITHUB_TOKEN=your-github-personal-access-token

# GitLab Pages Credentials
TEST_GITLAB_PROJECT_ID=12345678
TEST_GITLAB_TOKEN=your-gitlab-personal-access-token

# Cloudflare Stream Credentials
TEST_CF_STREAM_API_TOKEN=your-stream-api-token
TEST_CF_STREAM_CUSTOMER_CODE=your-customer-code

# Cloudflare Images Credentials
TEST_CF_IMAGES_ACCOUNT_HASH=your-images-account-hash
TEST_CF_IMAGES_API_TOKEN=your-images-api-token
