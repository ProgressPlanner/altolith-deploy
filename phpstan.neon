parameters:
    level: 8
    paths:
        - includes/
        - aether-site-exporter.php
    bootstrapFiles:
        - aether-site-exporter.php
        - phpstan-stubs.php
    excludePaths:
        - vendor/
        - tests/
    # Ignore WordPress core file require errors - PHPStan cannot verify
    # dynamic paths with ABSPATH constant at analysis time
    ignoreErrors:
        - '#Method.*has parameter \$request with generic class WP_REST_Request but does not specify its types#'
        - '#Path in require\(\) "assets/build/.*\.asset\.php" is not a file or it does not exist\.#'
        - '#Method Aether\\SiteExporter\\Plugin::registerProviderScriptFilter\(\) is unused\.#'
