# E2E Test Configuration
# Copy this file to .env.test and update with your local values
# NEVER commit .env.test with real credentials!

# WordPress site URL (your Local by Flywheel site)
WP_BASE_URL=http://localhost:10003

# WordPress admin credentials
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=password

# Aether configuration (for verification)
# These should match your plugin settings
R2_SITE_KEY=your-site-key

# Test options
# Run tests in headed mode (see browser) - useful for debugging
HEADED=false

# Slow down test execution (milliseconds) - useful for watching
SLOW_MO=0

# Enable debug logging
DEBUG=false

# ==============================================================================
# REAL CREDENTIALS FOR TESTING (Optional - only for integration tests)
# ==============================================================================
# Leave these blank to use mock values. Fill them in if you want to test
# against real APIs. These values are NEVER committed to git.

# R2 Storage Credentials
TEST_R2_BUCKET_NAME=sqlite-test
TEST_R2_ACCESS_KEY_ID=07236ed14e06337d0877c8c47e9faf3b
TEST_R2_SECRET_ACCESS_KEY=4f8163a2239fdb4ea71dbde9481377e95a909b46208312a7e04de6fafcfcf6fd

